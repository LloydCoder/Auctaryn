# Auctaryn environment template
# Copy to .env and replace placeholders. Never commit .env.
# Generate independent high-entropy values with: openssl rand -hex 32

ANTHROPIC_API_KEY=
AUCTARYN_API_KEY=replace-with-a-random-service-key
AUCTARYN_ADMIN_API_KEY=replace-with-a-different-random-admin-key
AUCTARYN_REQUIRE_STRONG_API_KEYS=true

AUCTARYN_HOST=0.0.0.0
AUCTARYN_PORT=8400
AUCTARYN_DEBUG=false
AUCTARYN_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUCTARYN_DB_PATH=data/auctaryn.db
AUCTARYN_EVIDENCE_DB=data/evidence.sqlite3
# Optional but recommended for keyed evidence authentication; use a separate 32+ byte secret.
AUCTARYN_EVIDENCE_HMAC_KEY=
# Prefer a mounted secret file in production; set this to its path when used.
AUCTARYN_EVIDENCE_HMAC_KEY_FILE=
# Production only: absolute host path to a separate 32+ byte key file.
# docker-compose.production.yml mounts this file at /run/secrets/auctaryn-evidence-hmac-key.

# ThreatFade is external. Production deployment requires a real HTTPS endpoint and service token.
THREATFADE_SERVICE_URL=https://replace-with-your-threatfade-service.example
THREATFADE_SERVICE_TOKEN=replace-with-your-threatfade-service-token

# Local evaluation leaves the trusted runtime adapter disabled.
# Production deployment requires a verified OpenShell gateway and OIDC service credentials.
AUCTARYN_RUNTIME_ADAPTER=
OPENSHELL_SANDBOX_NAME=
OPENSHELL_WORKSPACE=default
OPENSHELL_EXECUTION_TIMEOUT_SECONDS=60
OPENSHELL_OIDC_ISSUER=
OPENSHELL_OIDC_CLIENT_ID=
OPENSHELL_OIDC_CLIENT_SECRET=
OPENSHELL_OIDC_AUDIENCE=
OPENSHELL_ALLOW_USER_CREDENTIALS=false
# Host directory containing active_gateway and gateways/<name>/metadata.json.
OPENSHELL_SYSTEM_GATEWAY_DIR=/etc/openshell

# Production only: set these to the release tag and exact digest from the attested release manifest.
# AUCTARYN_RELEASE_TAG=vX.Y.Z
# AUCTARYN_IMAGE=ghcr.io/lloydcoder/auctaryn@sha256:<64-hex-digest>

AUCTARYN_DOMAIN=example.com
DASHBOARD_PORT=3000
VITE_API_URL=http://localhost:8400
VITE_WS_URL=ws://localhost:8400

LOG_LEVEL=INFO
