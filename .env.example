# TwinGuard Environment Variables
# Copy to .env and fill in your values

# API Keys
ANTHROPIC_API_KEY=your_claude_api_key_here
TWINGUARD_API_KEY=your_twinguard_api_key_here

# Server
TWINGUARD_HOST=0.0.0.0
TWINGUARD_PORT=8400
TWINGUARD_DEBUG=false

# Database
TWINGUARD_DB_PATH=data/twinguard.db

# ThreatFade Oracle
THREATFADE_SERVICE_URL=http://threatfade:8401

# OpenShell
OPENSHELL_GATEWAY_URL=http://localhost:8080

# Dashboard
DASHBOARD_PORT=3000
VITE_API_URL=https://twinguard.tinlance.com
VITE_WS_URL=wss://twinguard.tinlance.com

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
